# Copy this file to deploy/deploy.env on the server and replace placeholders.

APP_DOMAIN=reader.example.com
DEPLOY_ROOT=/opt/my-md-reader
WEB_ROOT=/var/www/my-md-reader/current
NGINX_SITE_PATH=/etc/nginx/conf.d/my-md-reader.conf
SSL_CERT_PATH=/etc/letsencrypt/live/reader.example.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/reader.example.com/privkey.pem
